# =========================
# Tag Your Moves - .gitignore
# =========================

# -------------------------
# Node.js / Frontend (React/Next.js) / Backend
# -------------------------
node_modules/
dist/
build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# -------------------------
# Python / ML / Services
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
.env_python/
ENV/

# Jupyter Notebooks
.ipynb_checkpoints

# -------------------------
# YOLO, PyTorch, & ML Models
# -------------------------
# Ignore heavy model weights and checkpoints
*.pt
*.pth
*.onnx
*.weights
*.engine
*.tflite
*.pb

# YOLO specific outputs and caches
runs/
*.cache
yolov*.pt
labels.cache

# Datasets and Media (Videos/Images for tagging)
*.mp4
*.avi
*.mov
*.jpg
*.jpeg
*.png
datasets/
data/images/
data/labels/

# -------------------------
# C/C++ / Hardware (If using Jetson/Arduino)
# -------------------------
*.out
*.exe
*.o
*.obj
*.dll
*.so
*.dylib
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install/
bin/

# -------------------------
# Environment Variables & Secrets
# -------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# -------------------------
# IDEs & OS Files
# -------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db